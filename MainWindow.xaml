<Window x:Class="PatientMonitorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hệ Thống Giám Sát Bệnh Nhân" Height="650" Width="850"
        Background="#1A1D24" WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- MÀN HÌNH INTRO CHÀO MỪNG -->
        <Grid x:Name="GridIntro" Background="#1A1D24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="90" Height="90" Margin="0,0,0,20">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#E63946" Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.04L12,21.35Z"/>
                        <Path Fill="White" Data="M11,7H13V10H16V12H13V15H11V12H8V10H11V7Z"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="PATIENT MONITOR SYSTEM" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="txtUserWelcome" Text="Xin chào: ..." Foreground="#007ACC" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Button x:Name="btnStart" Content="VÀO BẢNG ĐIỀU KHIỂN" Width="220" Height="45" 
                        Click="btnStart_Click" Background="#007ACC" Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- MÀN HÌNH CHÍNH DASHBOARD -->
        <Grid x:Name="GridMain" Visibility="Collapsed" Opacity="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Card 1: Kết nối MQTT -->
            <Border Grid.Row="0" Background="#252A34" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <DockPanel>
                    <Button x:Name="btnConnect" Content="Kết nối Giả lập MQTT" Width="170" Height="35" 
                            Click="btnConnect_Click" Background="#007ACC" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                    <TextBlock x:Name="lblStatus" Text="Trạng thái: Chưa kết nối" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#A0AAB0"/>
                </DockPanel>
            </Border>

            <!-- Card 2: Bảng Giả Lập Phát Dữ Liệu -->
            <StackPanel x:Name="panelControls" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <Button x:Name="btnSendNormal" Content="Gửi Giả Lập: Bình Thường" Width="210" Height="40" 
                        Click="btnSendNormal_Click" Margin="0,0,15,0" Background="#28A745" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                <Button x:Name="btnSendAlert" Content="Gửi Giả Lập: Cảnh Báo Huyết Áp" Width="250" Height="40" 
                        Click="btnSendAlert_Click" Background="#DC3545" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>

            <!-- Card 3: Nhật ký Giám sát Real-Time -->
            <GroupBox Grid.Row="2" Header="Nhật Ký Nhận Dữ Liệu MQTT Real-Time &amp; Lưu SQL" Padding="10" Foreground="#FFFFFF" FontWeight="Bold" BorderBrush="#3A3F4D">
                <RichTextBox x:Name="rtbLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Background="#111318" Foreground="White"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>