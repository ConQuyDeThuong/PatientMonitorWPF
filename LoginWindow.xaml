<Window x:Class="PatientMonitorWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Nhập - Hệ Thống Giám Sát Y Tế" Height="500" Width="420"
        Background="#1A1D24" WindowStartupLocation="CenterScreen" 
        SizeToContent="Height"
        ResizeMode="NoResize">
    <Grid Margin="35">
        <StackPanel VerticalAlignment="Center">
            <!-- Icon Trái Tim Y Tế -->
            <Viewbox Width="70" Height="70" Margin="0,0,0,15">
                <Canvas Width="24" Height="24">
                    <Path Fill="#E63946" Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.04L12,21.35Z"/>
                    <Path Fill="White" Data="M11,7H13V10H16V12H13V15H11V12H8V10H11V7Z"/>
                </Canvas>
            </Viewbox>

            <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <RadioButton x:Name="rbAdmin" Content="Quản trị viên" Foreground="White" FontSize="14" IsChecked="True"/>
            <RadioButton x:Name="rbBacSi" Content="Bác sĩ" Foreground="White" FontSize="14"/>
            <RadioButton x:Name="rbBenhNhan" Content="Bệnh nhân" Foreground="White" FontSize="14" Margin="0,0,0,15"/>
            <TextBlock Text="Tên đăng nhập:" Foreground="#A0AAB0" FontSize="13"/>
            <TextBox x:Name="txtUsername" Height="38" FontSize="14" Padding="8,5" 
                     Text="admin" 
                     VerticalContentAlignment="Center" 
                      Margin="0,0,0,15" 
                      Background="#2A2E39" 
                      Foreground="White" 
                      BorderThickness="1" 
                      BorderBrush="#3A3F4D"/>

            <TextBlock Text="Mật khẩu:" Foreground="#A0AAB0" FontSize="13" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword"
                         Password="123456"
                         Height="38" 
                         FontSize="14" 
                         Padding="8,5" 
                         VerticalContentAlignment="Center" 
                         Margin="0,0,0,25" 
                         Background="#2A2E39" 
                         Foreground="White" 
                         BorderThickness="1" 
                         BorderBrush="#3A3F4D"/>

            <Button x:Name="btnLogin" Content="ĐĂNG NHẬP" Height="42" Background="#007ACC" Foreground="White" 
                    FontWeight="Bold" FontSize="14" Click="btnLogin_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>